# Spot REST credentials (omit for public-only mode)
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=

# Futures REST + WS credentials (omit for public-only mode)
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# 'live' (default) or 'demo'
KRAKEN_FUTURES_ENV=live

# Enable trading tools (place/edit/cancel orders). Default: false
KRAKEN_TRADING_ENABLED=false

# Enable internal transfer tools. Default: false
KRAKEN_TRANSFERS_ENABLED=false

# Spot rate limit tier: starter | intermediate (default) | pro
KRAKEN_SPOT_RATE_LIMIT_TIER=intermediate

# HTTP request timeout in seconds (default 30)
KRAKEN_HTTP_TIMEOUT_SECONDS=30

# Log level: INFO (default) | DEBUG
KRAKEN_LOG_LEVEL=INFO
